<%- include ('partials/_user-header') %>
    
<script>
    function confirmDeletion(event) {
        if (!confirm("¿Estás seguro querer cambiar los datos de su cuenta?")) {
            event.preventDefault();
        }
    }
</script>

<form action="/user/edit/<%= user.id %>" onsubmit="confirmDeletion(event)"  method="POST" class="max-w-sm mx-auto">
    <% if (updated) { %>
       <div class="bg-green-100 border mb-5 border-green-400 text-green-700 px-4 py-3 rounded relative mt-5" role="alert">
           <span class="block sm:inline">Los datos de su cuenta han sido actualizados correctamente.</span>
       </div>
   <% } %>
    <div class="mt-8">
        <img src="/images/profile.jpg" alt="user" class="mx-auto w-48 h-48 rounded-full" />
    </div>
    <div class="mb-5">
        <label for="nombre" class="block mb-2 text-sm font-medium text-gray-900">Nombre</label>
        <input type="text" id="nombre" name="nombre" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 " required
        <% if ('nombre' in user) { %> value="<%= user.nombre %>" <% } %> />
    </div>
    <div class="mb-5">
        <label for="email" class="block mb-2 text-sm font-medium text-gray-900">Email</label>
        <input type="email" id="email" name="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 " required
        <% if ('email' in user) { %> value="<%= user.email %>" <% } %> />
    </div>
    <div class="mb-5">
        <label for="password" class="block mb-2 text-sm font-medium text-gray-900">Contraseña</label>
        <input type="password" id="password" name="password" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 " required title="mínimo 6 caracteres" pattern=".{6,}"
        <% if ('password' in user) { %> value="<%= user.password %>" <% } %> />
    </div>
    <div class="flex justify-center">
        <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Cambiar datos</button>
    </div>
</form>


<%- include ('partials/_footer') %>