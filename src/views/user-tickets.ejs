<%- include ('partials/_user-header') %>

<div class="mx-10 md:mx-24 mt-5 flex justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Tiquetes</h1>
    <a href="/user/trips" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Comprar tiquetes</a>
</div>
<div class="max-w-screen-lg md:mx-10 lg:mx-auto mt-5">
    <% if (tickets.length == 0) { %>
        <div class="flex justify-center items-center h-96">
            <h1 class="text-2xl text-gray-700">No se ha comprado ningún tiquete</h1>
        </div>
    <% } else { %>
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 ">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 ">
                <tr>
                    <th scope="col" class="px-6 py-3">
                        viaje
                    </th>
                    <th scope="col" class="px-6 py-3">
                        Fecha y hora
                    </th>
                    <th scope="col" class="px-6 py-3">
                        duración 
                    </th>
                    <th scope="col" class="px-6 py-3">
                        tiquetes
                    </th>
                    <th scope="col" class="px-6 py-3">
                        precio por tiquete
                    </th>
                    <th scope="col" class="px-6 py-3">
                        
                    </th>
                </tr>
            </thead>
            <tbody>
                <% tickets.forEach(ticket => { %>
                    <tr class="bg-white border-b">
                        <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
                            <%= ticket.origen %> a <%= ticket.destino %>
                        </th>
                        <td class="px-6 py-4">
                            <%= ticket.fecha.toISOString().slice(0, 10) %> <%= ticket.hora.slice(0, 5) %>
                        </td>
                        <td class="px-6 py-4">
                            <%= ticket.duracion %> horas
                        </td>
                        <td class="px-6 py-4">
                            <%= ticket.cantidad %>
                        </td>
                        <td class="px-6 py-4">
                            $<%= ticket.precio %>
                        </td>
                        <td class="px-6 py-4 flex flex-col lg:block">
                            <a href="/user/tickets/<%= ticket.viaje_id %>" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">cancelar</a>
                        </td>
                    </tr> 
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
   
<%- include ('partials/_footer') %>