<%- include ('partials/_user-header') %>

<% if(trips.length === 0) { %>
    <div class="flex justify-center items-center h-96">
        <h1 class="text-2xl text-gray-700">No hay viajes disponibles</h1>
    </div>
<% } else { %>
    <div class="flex justify-center my-8">
        <h1 class="text-center text-xl">Viajes disponibles</h1>
    </div>
    <div class="container mx-auto gap-y-12 grid grid-cols-1 place-items-center my-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% trips.forEach(trip => { %>
            <% if (trip.tiquetes_disponibles > 0) { %>
                <div class="w-80">
                    <a href="/user/trips/<%= trip.id %>" class="flex flex-col group bg-white border shadow-sm rounded-xl overflow-hidden hover:shadow-lg transition" href="#">
                        <div class="relative pt-[50%] sm:pt-[60%] lg:pt-[80%] rounded-t-xl overflow-hidden">
                          <img src="<%= imagePaths[parseInt(trip.id) % imagePaths.length] %>" class="size-full absolute top-0 start-0 object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out rounded-t-xl" alt="Imagen del viaje">
                        </div>
                        <div class="p-4 md:p-5">
                          <h3 class="text-lg font-bold text-gray-800">
                            Viaje de <%= trip.origen %> a <%= trip.destino %>
                          </h3>
                          <p class="mt-1 text-gray-500">
                            Fecha del viaje: <%= trip.fecha.toISOString().slice(0, 10) %><br>
                            Hora de salida: <%= trip.hora.slice(0, 5) %><br>
                            Tiquetes disponibles: <%= trip.tiquetes_disponibles %>
                        </p>
                        </div>
                      </a>
                </div>
            <% } %>
        <% }) %>
    </div>
<% } %>

<%- include ('partials/_footer') %>